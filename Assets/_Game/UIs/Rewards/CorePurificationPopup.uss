.reward-container {
    position: absolute;
    right: 50px;
    top: 50%;
    translate: 0 -50%;
    width: 350px;
    display: flex;
    flex-direction: column;
    background-color: rgba(20, 25, 30, 0.85);
    border-radius: 12px;
    padding: 16px;
    border-width: 2px;
    border-color: rgba(100, 200, 255, 0.5);
}

.reward-header {
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 16px;
    text-align: center;
}

.reward-btn {
    display: flex;
    flex-direction: column;
    background-color: rgba(40, 50, 60, 0.9);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(80, 100, 120, 0.8);
    margin-bottom: 12px;
    padding: 12px;
    transition-duration: 0.2s;
    transition-property: background-color, border-color, scale;
}

.reward-btn:hover {
    background-color: rgba(60, 80, 100, 0.95);
    border-color: rgba(150, 220, 255, 0.9);
    scale: 1.02;
}

.reward-content-wrapper {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.reward-icon {
    width: 48px;
    height: 48px;
    margin-right: 12px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.reward-text-container {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
}

.reward-type {
    color: rgb(150, 200, 255);
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.reward-title {
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    white-space: normal;
}

.reward-desc {
    color: rgb(200, 200, 200);
    font-size: 14px;
    white-space: normal;
}
