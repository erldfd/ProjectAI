.main-container {
    flex-grow: 1;
    background-color: rgba(10, 12, 18, 0.95);
    flex-direction: row;
    align-items: center;
    padding-left: 10%;
}

.menu-panel {
    width: 450px;
    flex-direction: column;
    justify-content: center;
}

.title-label {
    font-size: 80px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 80px;
    letter-spacing: 15px;
    text-shadow: 0px 0px 30px rgba(0, 150, 255, 0.6);
}

.menu-button {
    height: 70px;
    margin-bottom: 25px;
    background-color: rgba(30, 30, 40, 0.6);
    border-width: 2px;
    border-color: rgba(100, 100, 150, 0.3);
    border-radius: 12px;
    color: rgb(220, 220, 220);
    font-size: 26px;
    -unity-font-style: bold;
    transition-property: scale, translate, border-color, background-color, color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-circ;
    -unity-text-align: middle-left;
    padding-left: 40px;
}

.menu-button:hover {
    scale: 1.05;
    translate: 20px 0;
    border-color: rgb(0, 200, 255);
    background-color: rgba(40, 60, 90, 0.95);
    color: rgb(255, 255, 255);
    text-shadow: 0 0 10px rgba(0, 200, 255, 0.8);
}

.menu-button:active {
    scale: 0.95;
    background-color: rgba(0, 150, 255, 0.8);
}
