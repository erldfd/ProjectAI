<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd">

    <ui:VisualElement name="root" style="width: 100%; height: 100%; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.8);">
        <ui:VisualElement name="container" style="width: 600px; height: 800px; background-color: rgb(40, 40, 40); border-radius: 10px; padding: 20px; display: flex; flex-direction: column;">
            
            <!-- 타이틀 -->
            <ui:Label text="시작 소환수를 선택하세요 (최대 3개)" style="font-size: 24px; color: white; -unity-text-align: middle-center; margin-bottom: 20px; -unity-font-style: bold;" />
            
            <!-- 스킬 리스트 (버튼들이 동적으로 추가될 공간) -->
            <ui:ScrollView name="SkillListScrollView" style="flex-grow: 1; margin-bottom: 20px; background-color: rgb(30, 30, 30); border-radius: 5px; padding: 10px;" />
            
            <!-- 시작 버튼 -->
            <ui:Button name="StartButton" text="게임 시작" style="height: 60px; font-size: 20px; font-weight: bold; background-color: rgb(100, 150, 255); color: white; border-radius: 5px;" />
            
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
