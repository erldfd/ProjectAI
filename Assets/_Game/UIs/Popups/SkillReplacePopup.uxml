<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd">

    <ui:VisualElement name="root" style="width: 100%; height: 100%; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.8);">
        <ui:VisualElement name="container" style="width: 600px; height: 500px; background-color: rgb(40, 40, 40); border-radius: 10px; padding: 20px; display: flex; flex-direction: column;">
            
            <!-- 타이틀 -->
            <ui:Label text="슬롯이 가득 찼습니다!" style="font-size: 28px; color: rgb(255, 100, 100); -unity-text-align: middle-center; margin-bottom: 10px; -unity-font-style: bold;" />
            <ui:Label text="버릴 스킬을 선택하면 새로운 스킬이 장착됩니다." style="font-size: 18px; color: white; -unity-text-align: middle-center; margin-bottom: 20px;" />
            
            <!-- 현재 장착 중인 스킬 리스트 (Summon1 ~ Summon3) -->
            <ui:VisualElement name="CurrentSkillsContainer" style="flex-grow: 1; flex-direction: row; justify-content: space-around; margin-bottom: 20px;">
                <!-- 스킬 교체 버튼 1 -->
                <ui:Button name="btn-replace-1" text="스킬 1\n(이름)" style="width: 150px; height: 150px; font-size: 18px; background-color: rgb(60, 60, 60); color: white; border-radius: 10px; -unity-font-style: bold; white-space: normal;" />
                
                <!-- 스킬 교체 버튼 2 -->
                <ui:Button name="btn-replace-2" text="스킬 2\n(이름)" style="width: 150px; height: 150px; font-size: 18px; background-color: rgb(60, 60, 60); color: white; border-radius: 10px; -unity-font-style: bold; white-space: normal;" />
                
                <!-- 스킬 교체 버튼 3 -->
                <ui:Button name="btn-replace-3" text="스킬 3\n(이름)" style="width: 150px; height: 150px; font-size: 18px; background-color: rgb(60, 60, 60); color: white; border-radius: 10px; -unity-font-style: bold; white-space: normal;" />
            </ui:VisualElement>
            
            <!-- 취소 (버리기) 버튼 -->
            <ui:Button name="btn-cancel" text="새 스킬 버리기" style="height: 60px; font-size: 20px; font-weight: bold; background-color: rgb(100, 100, 100); color: white; border-radius: 5px;" />
            
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
